Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ToCppFunction", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"funcName_", ":", "\"\<f\>\""}], ",", 
     RowBox[{"varName_", ":", "\"\<r\>\""}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "code", "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Step", " ", "1"}], ":", 
       RowBox[{
       "CForm", " ", "the", " ", "whole", " ", "expression", " ", "at", " ", 
        "once"}]}], "*)"}], 
     RowBox[{
      RowBox[{"code", "=", 
       RowBox[{"ToString", "[", 
        RowBox[{"CForm", "[", "expr", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Step", " ", "2"}], ":", 
        RowBox[{
         RowBox[{"Fast", " ", "string", " ", "replacements"}], "-", 
         RowBox[{"no", " ", "regex", " ", "where", " ", "avoidable"}]}]}], 
       "*)"}], 
      RowBox[{"code", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"code", ",", 
         RowBox[{"{", 
          RowBox[{"(*", 
           RowBox[{"Bessel", " ", "functions"}], "*)"}], 
          RowBox[{
           RowBox[{"\"\<BesselI(0,\>\"", "->", "\"\<cyl_bessel_i(0,\>\""}], ",", 
           RowBox[{"\"\<BesselI(1,\>\"", "->", "\"\<cyl_bessel_i(1,\>\""}], ",", 
           RowBox[{"\"\<BesselK(0,\>\"", "->", "\"\<cyl_bessel_k(0,\>\""}], ",", 
           RowBox[{"\"\<BesselK(1,\>\"", "->", "\"\<cyl_bessel_k(1,\>\""}], ",", 
           RowBox[{"(*", 
            RowBox[{
            "If", " ", "you", " ", "want", " ", "to", " ", "catch", " ", 
             "any", " ", "integer", " ", "order", " ", 
             RowBox[{"generically", ":"}]}], "*)"}], 
           RowBox[{
            RowBox[{
            "RegularExpression", "[", "\"\<BesselI\\\\((\\\\d+),\>\"", "]"}], 
            ":>", "\"\<cyl_bessel_i($1,\>\""}], ",", 
           RowBox[{
            RowBox[{
            "RegularExpression", "[", "\"\<BesselK\\\\((\\\\d+),\>\"", "]"}], 
            ":>", "\"\<cyl_bessel_k($1,\>\""}], ",", 
           RowBox[{"(*", 
            RowBox[{"Log", " ", "and", " ", "pow"}], "*)"}], 
           RowBox[{"\"\<Log(\>\"", "->", "\"\<std::log(\>\""}], ",", 
           RowBox[{"\"\<Power(\>\"", "->", "\"\<std::pow(\>\""}], ",", 
           RowBox[{"\"\<Sqrt(\>\"", "->", "\"\<std::sqrt(\>\""}], ",", 
           RowBox[{"\"\<Abs(\>\"", "->", "\"\<std::abs(\>\""}], ",", 
           RowBox[{"\"\<Exp(\>\"", "->", "\"\<std::exp(\>\""}], ",", 
           RowBox[{"(*", 
            RowBox[{"Mathematica", " ", "uses", " ", "E", " ", "for", " ", 
             RowBox[{"Euler", "'"}], "s", " ", "number"}], "*)"}], 
           RowBox[{"\"\< E \>\"", "->", "\"\< M_E \>\""}]}], "}"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Step", " ", "3"}], ":", "Assemble"}], "*)"}], 
      RowBox[{"\"\<// Requires: #include <cmath>\\n\>\"", 
       "<>", "\"\<// Requires: #include \
<boost/math/special_functions/bessel.hpp>\\n\\n\>\"", "<>", "\"\<double \>\"",
        "<>", "funcName", "<>", "\"\<(double \>\"", "<>", "varName", 
       "<>", "\"\<) {\\n\>\"", 
       "<>", "\"\<    using boost::math::cyl_bessel_i;\\n\>\"", 
       "<>", "\"\<    using boost::math::cyl_bessel_k;\\n\\n\>\"", 
       "<>", "\"\<    return \>\"", "<>", "code", "<>", "\"\<;\\n\>\"", 
       "<>", "\"\<}\>\""}]}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"ToCppFunction", "[", 
    RowBox[{"simpleTemp", ",", "\"\<f\>\"", ",", "\"\<r\>\""}], "]"}], "]"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Print", "[", 
    RowBox[{"ToCppFunction", "[", 
     RowBox[{"simplerho", ",", "\"\<f\>\"", ",", "\"\<r\>\""}], "]"}], "]"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"ToCppFunction", "[", 
   RowBox[{"simplep", ",", "\"\<f\>\"", ",", "\"\<r\>\""}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"ToCppFunction", "[", 
   RowBox[{"simpleux", ",", "\"\<f\>\"", ",", "\"\<r\>\""}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"ToCppFunction", "[", 
   RowBox[{"simpleuy", ",", "\"\<f\>\"", ",", "\"\<r\>\""}], "]"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9884373229809837`*^9, 3.9884373867926846`*^9}, {
   3.9884376530575504`*^9, 3.9884377536266727`*^9}, {3.988437944859764*^9, 
   3.988437948326538*^9}, {3.988439350227749*^9, 3.9884393546179924`*^9}, {
   3.9884396926168423`*^9, 3.988439697832058*^9}, {3.9884398389778004`*^9, 
   3.9884398596089287`*^9}, {3.9884398956596394`*^9, 
   3.9884399097364445`*^9}, {3.991994401292254*^9, 3.9919944071622143`*^9}, 
   3.991994774477869*^9},
 CellLabel->
  "In[206]:=",ExpressionUUID->"cfe5bd04-ab1d-174a-9872-0d24c3336bae"],

Cell[CellGroupData[{

Cell[BoxData["\<\"// Requires: #include <cmath>\\n// Requires: #include \
<boost/math/special_functions/bessel.hpp>\\n\\ndouble f(double r) {\\n    \
using boost::math::cyl_bessel_i;\\n    using boost::math::cyl_bessel_k;\\n\\n \
   return 1.1475416669755338 - 1.4136499460087132e-19/std::pow(r,5) - \
1.9855291553960966e-18/std::pow(r,4) - 8.503184547098384e-18/std::pow(r,3) - \
7.51454581320324e-16/std::pow(r,2) - 0.006824199418861071/r + \
0.009607734992218002*r + 1.1347378340243468e-9*std::pow(r,2) - \
2.861003252615381e-7*std::pow(r,3) + 7.835105240179381e-8*std::pow(r,4) - \
3.2050302992908996e-6*std::pow(r,5) + \
2.1335502466342462e-17*cyl_bessel_i(0,18.250101513540354*r) - \
2.3955884082321502e-17*cyl_bessel_i(1,18.250101513540354*r) - \
7.515152743849166e6*cyl_bessel_k(0,18.250101513540354*r) - \
1.7297773670560922e6*cyl_bessel_k(1,18.250101513540354*r) + \
1.1304068783278136*std::log(r);\\n}\"\>"], "Print",
 CellChangeTimes->{3.988437391655239*^9, 3.9884395696678486`*^9, 
  3.9884397003581886`*^9, 3.988439913149805*^9, 3.991994186001911*^9, 
  3.991994408084223*^9, 3.9919947755847597`*^9},
 CellLabel->
